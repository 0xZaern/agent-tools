{
  "name": "depgraph",
  "version": "1.0.0",
  "description": "Token-efficient local dependency graph digest for AI agents — maps import/export edges for TypeScript/JavaScript projects, detects cycles, identifies entry points and heaviest subtrees at a fraction of raw file-read token cost",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    }
  },
  "bin": {
    "depgraph": "dist/cli.js"
  },
  "files": [
    "dist/lib",
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "mcp",
    "typescript",
    "javascript",
    "dependency-graph",
    "imports",
    "cycles",
    "context",
    "developer-tools"
  ],
  "dependencies": {
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.3"
  }
}
